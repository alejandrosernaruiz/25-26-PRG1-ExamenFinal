        double total_depositado = 0; 
        
        // Nuevas vars
        double comision = 1.0; 
        double limite_diario = 600.0; 
        double retirado_hoy = 0.0; 
        double comision_total = 0.0; 
        
        // Historial
        String[] hist_t = new String[10]; // tipo
        double[] hist_m = new double[10]; // monto
        int hist_idx = 0;

        System.out.println("Cajero Automatico - Banco Nacional");
