                System.out.println("Tu saldo actual es: " + saldo + " euros");
            } else if (o == 2) {
                System.out.print("Cuanto deseas retirar? ");
                double c = sc.nextDouble();
                if (c <= 0) {
                    System.out.println("Cantidad invalida.");
